# Containerfile.web — Nginx front for the OPTIONAL two-container deploy
# (see docker-compose.yml). The single-container deploy is
# Containerfile.game — one port, static + /ws, zero configuration.
FROM docker.io/library/nginx:1.27-alpine

COPY index.html /usr/share/nginx/html/
COPY src/ /usr/share/nginx/html/src/
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
